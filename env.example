# Copy to project root and edit: cp env.example .env
# Loaded by app/config.py from ./.env (see README).

# --- App ---
# APP_NAME=layer-orchestrator-v1
# MCP_NAME=layer-orchestrator-v1-dev
APP_VERSION=dev
ENV=dev

# --- HTTP listen (orchestrator) ---
HTTP_PORT=8000
PORT=8000

# --- LLM (required for /v1/orchestrator/answer): POST {LLM_GATEWAY_BASE_URL}/v1/chat/completions ---
LLM_GATEWAY_BASE_URL=http://127.0.0.1:30180
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# LLM_API_KEY=

# Optional aliases (same values as above; not read by app/config.py).
INFERENCE_URL=http://127.0.0.1:30180
INFERENCE_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- RAG (this app): POST {RAG_HTTP_BASE_URL}/v1/rag/query ---
RAG_HTTP_BASE_URL=http://127.0.0.1:30183
# RAG_COLLECTION_BASE=taixing_knowledge
# RAG_K=5
# RAG_K_MAX=40
# RAG_INCLUDE_RETRIEVAL_HITS=true

# --- Web search (tool route web_search via Tavily) ---
# TAVILY_API_KEY=tvly-...
# TAVILY_SEARCH_DEPTH=advanced
# TAVILY_MAX_RESULTS=5

# --- MCP RAG (default: stream via MCP rag_query when MCP_RAG_BASE_URL / RAG_HTTP_BASE_URL is set) ---
# USE_MCP_RAG=true
# MCP_RAG_BASE_URL=http://127.0.0.1:30183
# Set USE_MCP_RAG=false to force direct HTTP POST /v1/rag/query (no answer_delta streaming)

# --- MCP tools (github_search via ask_repo) ---
# USE_MCP_TOOLS=false
# MCP_GITHUB_BASE_URL=http://127.0.0.1:30185

# --- Intent router (plain text under app/prompts/{ROUTER_PROMPT_VERSION}.txt) ---
ROUTER_PROMPT_VERSION=router-v3.00

# --- Retrieval / embedding stack (reference for RAG sidecars; not read by app/config.py) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
EMBEDDING_URL=http://127.0.0.1:30181
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_SIZE=1024
TOP_K_DENSE=20
RRF_K=60
RERANK_URL=http://127.0.0.1:30182
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=50
RERANK_RETURN_TOP_K=25
RETRIEVE_FALLBACK_N=8
FINAL_CONTEXT_TOP_K=12

# --- LangSmith (optional) ---
LANGSMITH_TRACING=false
# LANGCHAIN_PROJECT=
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=
# LANGSMITH_API_KEY=

# --- Workflow limits (defaults shown in README) ---
# TOOLS_TIMEOUT_S=60
# INVOKE_TIMEOUT_S=120
# READINESS_TIMEOUT_S=5
# READINESS_RAG_QUESTION=.   # probe question for GET /ready RAG check (default: .)
# MAX_REQUEST_BODY_MB=1
# MAX_HISTORY_MESSAGES=50
# MAX_QUESTION_CHARS=8000
# MAX_CONTEXT_CHARS=120000
# REQUEST_TIMEOUT_MS=30000
# STREAM_IDLE_TIMEOUT_MS=30000
# MAX_CONCURRENT_DOWNSTREAM_CALLS=32
# RAG_HTTP_MAX_ATTEMPTS=3
# RAG_HTTP_RETRY_BACKOFF_S=0.5

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_TIMEZONE=America/New_York
